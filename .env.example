# App runtime: Transaction pooler (IPv4). Encode @ in password as %40.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrations / seed: Session pooler (port 5432)
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Supabase Dashboard → Project Settings → API → service_role (secret)
# Used by /api/admin/upload for Storage uploads. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="admin123"
SEED_ADMIN_NAME="사이트 관리자"

# Resend (consultation emails). FROM must use a verified domain.
RESEND_API_KEY="re_..."
CONSULTATION_FROM="noreply@snsoft.co.kr"
CONSULTATION_NOTIFY_TO="hjs@snsoft.co.kr"

# Naver Cloud Platform → AI·NAVER API → Application → Client ID.
# Web 서비스 URL에 이 사이트 주소(localhost 포함)를 등록해야 지도가 표시됩니다.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID="sbw2sbeytg"
